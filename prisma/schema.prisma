// Prisma schema for the case-file audit application.
// SQLite by default (zero-config, file-based); swap the datasource
// provider/url to postgresql for a multi-user production deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// A legal case / accounting-expert file being audited. Opened through the
// 4-phase judicial-expertise intake wizard (see intakeStatus).
// ---------------------------------------------------------------------------
model Case {
  id               String  @id @default(cuid())
  // --- المرحلة 1: بيانات القضية الأساسية ---
  caseNumber       String // رقم الدعوى
  title            String // عنوان/موضوع الدعوى (عنوان مختصر للقضية)
  court            String? // المحكمة / الجهة القضائية
  circuit          String? // الدائرة
  litigationDegree String? // FIRST_INSTANCE | APPEAL | EXECUTION | OTHER
  caseCategory     String? // نوع الدعوى: COMMERCIAL | CIVIL | REAL_ESTATE | LABOR | OTHER
  caseType         String  @default("ACCOUNTING_EXPERT") // LITIGATION | ACCOUNTING_EXPERT — selects which lib/presets.ts group applies
  notes            String? // ملاحظات أولية

  // --- المرحلة 2: بيانات مأمورية الخبرة ---
  mandateDecisionDate DateTime? // تاريخ قرار / حكم ندب الخبرة
  mandateReceivedDate DateTime? // تاريخ استلام المأمورية
  mandateAcceptedDate DateTime? // تاريخ قبول المأمورية
  nextHearingDate     DateTime? // تاريخ الجلسة القادمة
  reportDeadlineDate  DateTime? // آخر موعد لإيداع تقرير الخبرة
  appointmentCapacity String? // SOLE_EXPERT | COMMITTEE_CHAIR | COMMITTEE_MEMBER
  committeeMembers    String? // JSON: [{ name, specialization }] — إن كانت لجنة خبراء
  mandateNature       String? // JSON string[] من طبيعة المأمورية الحسابية (فحص وتدقيق الحسابات...)
  mandateNotes        String? // ملاحظات على المأمورية

  // تتبّع تقدّم المعالج (wizard) حتى يمكن استئناف ملف لم يُستكمل فتحه
  intakeStatus String @default("DRAFT_PHASE_1") // DRAFT_PHASE_1..4 | ACTIVE

  // الموديول 3 — علامة جاهزية الملف للدراسة، تُبدَّل يدوياً بمعرفة الخبير
  readinessStatus String @default("NEEDS_MORE_WORK") // NEEDS_MORE_WORK | READY_FOR_STUDY

  // مراسلة المتعامل (خطاب "استكمال المستندات" — منفصل عن وكلاء الأطراف في الإخطار)
  clientName  String? // اسم المتعامل (من نتلقى منه المستندات)
  clientEmail String? // البريد الإلكتروني للمتعامل

  status    String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties          CaseParty[]
  requirements     Requirement[]
  documents        Document[]
  emailDrafts      EmailDraft[]
  notices          Notice[]
  analyses         CaseAnalysis[]
  meetingAttendees MeetingAttendee[]
  hearingSessions  HearingSession[]
  documentDemands  DocumentDemand[]
  siteInspections  SiteInspection[]
  courtReport      CourtReport?
}

// ---------------------------------------------------------------------------
// A claimant/respondent party on a case (المدعي / المستأنف .. المدعى عليه /
// المستأنف ضده) — a case can have more than one of each.
// ---------------------------------------------------------------------------
model CaseParty {
  id           String  @id @default(cuid())
  caseId       String
  case         Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role         String // CLAIMANT | RESPONDENT
  name         String
  order        Int     @default(0)
  capacityNote String? // صفة الطرف كما تُطبع في تقرير الخبرة: "شريك بنسبة 68% ومدير الشركة"

  submittedDocuments Document[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// A single required document/item in the case checklist (متطلبات الملف).
// ---------------------------------------------------------------------------
model Requirement {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  presetKey   String? // key referencing lib/presets.ts, null for fully custom items
  labelAr     String // اسم المتطلب بالعربية
  labelEn     String? // English label (optional, for reference)
  category    String? // تصنيف (مالي / قانوني / شركات ...)
  description String? // تفاصيل إضافية (مثال: الفترة الزمنية المطلوبة)
  periodStart DateTime? // بداية الفترة المطلوبة إن وجدت
  periodEnd   DateTime? // نهاية الفترة المطلوبة إن وجدت
  isRequired  Boolean   @default(true)
  order       Int       @default(0)

  status         String  @default("NOT_ANALYZED") // PROVIDED | PARTIALLY_PROVIDED | MISSING | NOT_ANALYZED
  aiNotes        String? // شرح/تعليل الذكاء الاصطناعي
  aiConfidence   Float?
  manualOverride Boolean @default(false) // true إذا عدّل المستخدم الحالة يدوياً
  overrideNotes  String?
  relatedTask    String? // المهمة المرتبطة به من مأمورية الخبرة (من التحليل الأولي، الموديول 1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches RequirementMatch[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// An uploaded file belonging to a case.
// ---------------------------------------------------------------------------
model Document {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName       String
  storedPath     String // relative path under the uploads directory
  mimeType       String
  fileSize       Int
  fileKind       String // pdf | docx | xlsx | csv | image
  parseStatus    String   @default("PENDING") // PENDING | PARSED | FAILED | UNSUPPORTED
  parseError     String?
  extractedText  String? // plain-text extract used for AI matching
  detectedTitle  String? // عنوان المستند إن أمكن استنتاجه
  detectedDates  String? // JSON-encoded array of ISO dates found in the document
  detectedPeriod String? // نطاق الفترة الزمنية المستنتج (نص وصفي)
  pageCount      Int?
  uploadedAt     DateTime @default(now())

  // مُعبّأة من التحليل الأولي بالذكاء الاصطناعي (المرحلة 4) — تصنيف المستند
  // وتحديد الطرف الذي قدّمه، دون الحاجة لتصنيف يدوي عند الرفع.
  docCategory        String? // PRELIMINARY_RULING | STATEMENT_OF_CLAIM | PARTY_MEMO | PARTY_ATTACHMENT | OTHER_JUDICIAL | UNSPECIFIED
  submittedByPartyId String?
  submittedByParty   CaseParty? @relation(fields: [submittedByPartyId], references: [id], onDelete: SetNull)

  matches         RequirementMatch[]
  poaForAttendees MeetingAttendee[] // مرفق كمستند توكيل (POA) لحاضر ما، إن وُجد

  @@index([caseId])
  @@index([submittedByPartyId])
}

// ---------------------------------------------------------------------------
// Join between a Requirement and a Document, produced by the AI matcher
// (a requirement can be satisfied by multiple documents and vice versa).
// ---------------------------------------------------------------------------
model RequirementMatch {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  confidence    Float       @default(0)
  reasoning     String? // تعليل المطابقة
  pageRefs      String? // مراجع الصفحات ذات الصلة، مثال: "2-4, 7"

  createdAt DateTime @default(now())

  @@unique([requirementId, documentId])
}

// ---------------------------------------------------------------------------
// A generated Arabic email/letter draft requesting missing documents.
// ---------------------------------------------------------------------------
model EmailDraft {
  id        String    @id @default(cuid())
  caseId    String
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subject   String
  bodyAr    String
  deadline  DateTime?
  createdAt DateTime  @default(now())

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// A formal notice (إخطار) — e.g. "اخطار اجتماع الخبرة الأول" — notifying the
// opposing parties' legal representatives of an expert meeting and
// requesting documents ahead of it. Content is deterministic (no AI): it
// follows a fixed legal letter format, rendered both as a printable
// letterhead document and as an email.
// ---------------------------------------------------------------------------
model Notice {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  noticeType  String @default("EXPERT_MEETING") // reserved for future notice types
  noticeLabel String // مثال: "الأول" / "الثاني"
  subjectLine String // موضوع الإخطار

  referenceLetterNumber String? // رقم كتاب التكليف
  referenceLetterDate   DateTime? // تاريخ كتاب التكليف

  meetingDate      DateTime
  meetingTimeLabel String // نص حر، مثال: "12:30 ظهراً"
  meetingMethod    String   @default("تقنية الاتصال المرئي بواسطة تطبيق تقنية ZOOM MEETING")
  meetingLink      String?
  meetingId        String?
  meetingPasscode  String?

  documentsDeadlineDays Int    @default(2)
  requestedFromLabel    String // من المطلوب منه تزويد المستندات، مثال: "وكيل المدعيان"

  addressees     String // JSON: [{ lawFirmName, roleLabel, representedNames: string[] }]
  requestedItems String // JSON: string[] — البنود المرقّمة

  expertTitle              String @default("الخبير الحسابي")
  expertName               String
  expertRegistrationNumber String // رقم القيد وزارة العدل

  createdAt DateTime @default(now())

  deliveries NoticeDelivery[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// المرحلة 4 — التحليل الأولي لملف الدعوى: تقرير مبدئي يقرأه الخبير ويعتمده،
// يُنتج بالذكاء الاصطناعي (أو بمحرك احتياطي محدود بدون مفتاح API) من كامل
// المستندات المرفوعة في المرحلة 3. عند الاعتماد تتحوّل missingDocuments إلى
// صفوف Requirement فعلية، فتستمر شاشة المتطلبات ونموذج الإخطار بالعمل دون
// أي تعديل.
// ---------------------------------------------------------------------------
model CaseAnalysis {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status String @default("DRAFT") // DRAFT | APPROVED
  mode   String // AI | OFFLINE

  caseSummary  String // ملخص الدعوى
  mandateText  String // نص مأمورية الخبرة كما ورد في الحكم
  mandateTasks String // JSON string[] — تقسيم المأمورية إلى مهام

  receivedDocumentsSummary String // JSON: [{ documentId, submittedByPartyId, periodLabel, status }]
  missingDocuments         String // JSON: [{ item, requestedFromPartyIds: string[], reason, relatedTask }]
  unclearPoints            String // JSON string[]
  claimantQuestions        String // JSON string[]
  respondentQuestions      String // JSON string[]
  expertNotes              String // ملاحظات أولية للخبير

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// الموديول 2 — إدارة الاجتماع والتواصل: سجل الحضور/الوكلاء عن كل طرف
// (POA) — سجل واحد للدعوى يمتد عبر كل اجتماعاتها (انظر
// HearingAttendanceRecord للحضور الفعلي لكل اجتماع على حدة).
// ---------------------------------------------------------------------------
model MeetingAttendee {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name              String
  role              String // CLAIMANT | RESPONDENT | POA | EXPERT | OTHER
  representingParty String? // اسم الطرف الذي يمثله الوكيل، إن وُجد
  attendanceStatus  String  @default("PENDING") // PENDING | PRESENT | LATE | ABSENT — الحالة المتوقعة قبل الاجتماع
  order             Int     @default(0)

  documentId String? // مستند التوكيل (POA) المرفوع، إن وُجد
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  attendanceRecords HearingAttendanceRecord[]
  noticeDeliveries  NoticeDelivery[]

  @@index([caseId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// الموديول 2 — اجتماعات الخبرة (قائمة لكل دعوى — قد تُعقد أكثر من مرة).
// كل اجتماع له "غرفة إدارة" حية: حالة/توقيتات فعلية، محضر مركّب من بيانات
// منظّمة (حضور + كلمة افتتاحية + أسئلة وأجوبة + مطالبات مستندات)، ونص
// تفريغ يُصحَّح بالذكاء الاصطناعي.
// ---------------------------------------------------------------------------
model HearingSession {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  label           String    @default("الاجتماع الأول") // تمييز بين اجتماعات الدعوى المتعددة
  status          String    @default("NOT_SCHEDULED") // NOT_SCHEDULED | SCHEDULED | IN_PROGRESS | COMPLETED
  meetingDate     DateTime?
  meetingTime     String? // نص حر، مثال: "12:30 ظهراً" — يطابق شكل Notice.meetingTimeLabel
  meetingMethod   String? // مثال: تقنية الاتصال المرئي بواسطة ZOOM، أو حضوري
  meetingLink     String?
  meetingId       String?
  meetingPasscode String?
  openingNotes    String? // ملاحظات/نص افتتاحي حر (الكلمة الافتتاحية القضائية)

  startedAt DateTime? // بدء الاجتماع فعلياً
  endedAt   DateTime? // انتهاء الاجتماع فعلياً

  rawTranscript       String? // نص تفريغ الاجتماع كما رُفع
  correctedTranscript String? // بعد تصحيحه بالذكاء الاصطناعي بالاستعانة بسياق الدعوى
  minutesDraft        String? // مسودة محضر الجلسة النهائية (مركّبة آلياً من البيانات المنظمة، قابلة للتعديل اليدوي)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions         HearingQuestion[]
  attendanceRecords HearingAttendanceRecord[]
  documentDemands   DocumentDemand[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// الموديول 2 — سجل الأسئلة والأجوبة لكل اجتماع (مبدئياً من أسئلة التحليل
// الأولي المُولّدة بالذكاء الاصطناعي في الموديول 1، وقابلة للإضافة يدوياً).
// ---------------------------------------------------------------------------
model HearingQuestion {
  id               String         @id @default(cuid())
  hearingSessionId String
  hearingSession   HearingSession @relation(fields: [hearingSessionId], references: [id], onDelete: Cascade)

  partyRole    String // CLAIMANT | RESPONDENT
  questionText String
  sourceType   String  @default("MANUAL") // GENERATED | MANUAL
  answerText   String?
  status       String  @default("PENDING") // PENDING | ANSWERED | DEFERRED | REFUSED
  order        Int     @default(0)

  @@index([hearingSessionId])
}

// ---------------------------------------------------------------------------
// الموديول 2 — الحضور الفعلي (roll call) لكل اجتماع على حدة — منفصل عن
// MeetingAttendee.attendanceStatus الذي يمثل الحالة المتوقعة قبل الاجتماع.
// ---------------------------------------------------------------------------
model HearingAttendanceRecord {
  id               String          @id @default(cuid())
  hearingSessionId String
  hearingSession   HearingSession  @relation(fields: [hearingSessionId], references: [id], onDelete: Cascade)
  attendeeId       String
  attendee         MeetingAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  status   String    @default("PENDING") // PENDING | PRESENT | LATE | ABSENT
  markedAt DateTime?

  @@unique([hearingSessionId, attendeeId])
  @@index([hearingSessionId])
}

// ---------------------------------------------------------------------------
// الموديول 2/3 — مطالبات المستندات الناتجة عن اجتماع (تُعرض أيضاً في
// الموديول 3 لمتابعة الاستيفاء).
// ---------------------------------------------------------------------------
model DocumentDemand {
  id               String          @id @default(cuid())
  caseId           String
  case             Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hearingSessionId String?
  hearingSession   HearingSession? @relation(fields: [hearingSessionId], references: [id], onDelete: SetNull)

  item                  String
  requestedFromPartyIds String // JSON string[]
  deadline              DateTime
  status                String   @default("PENDING") // PENDING | PARTIALLY_RECEIVED | RECEIVED
  notes                 String?
  relatedTask           String? // المهمة المرتبطة به من مأمورية الخبرة، يُختار يدوياً عند الإنشاء

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([hearingSessionId])
}

// ---------------------------------------------------------------------------
// الموديول 2 — تتبّع تسليم الإخطارات الرسمية لكل حاضر/وكيل.
// ---------------------------------------------------------------------------
model NoticeDelivery {
  id         String          @id @default(cuid())
  noticeId   String
  notice     Notice          @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  attendeeId String
  attendee   MeetingAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  status         String    @default("SENT") // SENT | ACKNOWLEDGED
  sentAt         DateTime  @default(now())
  acknowledgedAt DateTime?

  @@unique([noticeId, attendeeId])
  @@index([noticeId])
}

// ---------------------------------------------------------------------------
// الموديول 3 — سجل زيارات المعاينة الميدانية (الانتقال والمعاينة).
// ---------------------------------------------------------------------------
model SiteInspection {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  visitDate DateTime
  location  String
  purpose   String
  attendees String? // JSON string[]

  equipmentReviewed     String? // الأجهزة/الخوادم التي تم فحصها
  booksReviewed         String? // الدفاتر المالية التي روجعت
  notes                 String? // ملاحظات عامة أخرى
  attachmentDocumentIds String? // JSON string[] — صور/مستندات مرفقة (Document.id)
  visitReportDraft      String? // مسودة محضر الانتقال والمعاينة (مركّبة آلياً)

  createdAt DateTime @default(now())

  testimonies SiteInspectionTestimony[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// الموديول 3 — إفادات ميدانية مسجَّلة أثناء زيارة معاينة.
// ---------------------------------------------------------------------------
model SiteInspectionTestimony {
  id               String         @id @default(cuid())
  siteInspectionId String
  siteInspection   SiteInspection @relation(fields: [siteInspectionId], references: [id], onDelete: Cascade)

  personName    String
  personRole    String? // مثال: موظف مالي، مدير الفرع
  statementText String
  order         Int     @default(0)

  @@index([siteInspectionId])
}

// ---------------------------------------------------------------------------
// الموديول 4 — استوديو التقرير القضائي (v2: أقسام تمهيدية مُجمَّعة آلياً من
// الموديولات 1-3 + تتبّع مصدر كل كتلة نصية (provenance) + قسم مستقل لكل
// مهمة من مهام المأمورية، انظر CourtReportTask أدناه). أرقام تصفية الحساب
// (settlement) تُحسب من أرقام المهام المعتمدة — لا تُخزَّن كأرقام مستقلة
// هنا لتفادي "أرقام إجمالية بلا سند" (انظر lib/reports/liquidation.ts).
// ---------------------------------------------------------------------------
model CourtReport {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status String @default("DRAFT") // DRAFT | FINAL

  // الأقسام التمهيدية
  introduction      String? // المقدمة
  mandateSummary    String? // ملخص المأمورية
  partiesOverview   String? // الأطراف وصفاتهم
  proceduralHistory String? // الإجراءات (سرد فوق الجدول الزمني المُجمَّع آلياً)
  documentInventory String? // حافظة المستندات (سرد فوق الجرد المُجمَّع آلياً)

  // مصدر كل قسم: EXTRACT | AI_DRAFT | EXPERT_CERTIFIED
  introductionProvenance      String @default("AI_DRAFT")
  mandateSummaryProvenance    String @default("AI_DRAFT")
  partiesOverviewProvenance   String @default("AI_DRAFT")
  proceduralHistoryProvenance String @default("AI_DRAFT")
  documentInventoryProvenance String @default("AI_DRAFT")

  // الخلاصة وتصفية الحساب — السرد فقط؛ الأرقام محسوبة من CourtReportTask
  settlementBeneficiary         String?
  settlementNarrative           String?
  settlementNarrativeProvenance String  @default("AI_DRAFT")

  // خطاب الغلاف الموجَّه للقاضي (نمط التقرير المرجعي)
  judgeName  String? // "سعادة القاضي / حسام شريف محمد سيف"
  judgeTitle String? // "قاضي محكمة عجمان الاتحادية الابتدائية – المحكمة الابتدائية المدنية"
  letterDate DateTime?

  // خامساً: نطاق الفحص والمستندات المعتمدة (قبل الدخول في تحليل كل مهمة)
  scopeNarrative           String?
  scopeNarrativeProvenance String  @default("AI_DRAFT")

  // سابعاً: عرض التقرير المبدئي على الأطراف
  preliminaryReportSharedAt DateTime?
  objectionsDeadline        DateTime?
  objectionsIntro           String?
  objectionsIntroProvenance String    @default("AI_DRAFT")

  // ثامناً: الخلاصة — بنود مرقّمة (تُبذَر من رأي الخبرة المعتمَد لكل مهمة)
  conclusionIntro      String?
  conclusionItemsJson  String? // JSON string[]
  conclusionClosing    String?
  conclusionProvenance String  @default("AI_DRAFT")

  // لقطة التجميع الحتمي وقت آخر توليد (JSON — نفس عرف تخزين JSON كنص
  // المُتّبع في كل هذا المخطط لقاعدة SQLite)
  timelineJson    String? // JSON: ProceduralTimelineEvent[]
  inventoryJson   String? // JSON: DocumentInventory
  partyClaimsJson String? // JSON: PartyClaimsSnapshot

  generationMode    String? // AI | OFFLINE — نتيجة آخر توليد
  generationWarning String?
  lastGeneratedAt   DateTime?
  finalizedAt       DateTime?

  updatedAt DateTime @updatedAt

  tasks      CourtReportTask[]
  tables     CourtReportTable[]
  objections ReportObjection[]
}

// قسم مستقل لكل مهمة من مهام المأمورية (CaseAnalysis.mandateTasks). بما أن
// تلك المصفوفة نصوص حرة بلا معرّفات ثابتة، هذا الصف هو الهوية المستقرة
// للمهمة: يلتقط نصها حرفياً وترتيبها (taskIndex) وقت التوليد.
model CourtReportTask {
  id            String      @id @default(cuid())
  courtReportId String
  courtReport   CourtReport @relation(fields: [courtReportId], references: [id], onDelete: Cascade)

  taskIndex Int // ترتيب المهمة في mandateTasks وقت اللقطة (0-based)
  taskText  String // نص المهمة حرفياً كما ورد في المأمورية

  claimantPosition   String? // موقف المدعي
  respondentPosition String? // موقف المدعى عليه
  forensicAnalysis   String? // بحث الخبرة
  missingDocsImpact  String? // أثر المستندات الناقصة (حتمي دوماً — EXTRACT)
  expertVerdict      String? // رأي الخبرة — الكتلة الوحيدة التي تحكم بوابة التصدير

  claimantPositionProvenance   String @default("AI_DRAFT")
  respondentPositionProvenance String @default("AI_DRAFT")
  forensicAnalysisProvenance   String @default("AI_DRAFT")
  expertVerdictProvenance      String @default("AI_DRAFT")

  claimantAmount   Float? // مطالبة المدعي المعتمدة لهذه المهمة (درهم) — null لمهمة غير مالية
  respondentOffset Float? // خصم/مقاصة المدعى عليه المعتمدة (درهم)
  amountNote       String? // سند الرقم (مستند/أساس الاحتساب)

  // مرفقات المهمة — تُحسب آلياً وقت التوليد (مطابقة نصية مع relatedTask)
  // وتبقى قابلة للتعديل اليدوي بعدها، بنفس عرف SiteInspection.attachmentDocumentIds
  linkedDocumentIds    String? // JSON string[] — Document.id
  linkedRequirementIds String? // JSON string[] — Requirement.id
  linkedDemandIds      String? // JSON string[] — DocumentDemand.id
  exhibitLinksJson     String? // JSON: [{ documentId, via, score, sourceLabel }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables CourtReportTable[]

  @@unique([courtReportId, taskIndex])
  @@index([courtReportId])
}

// جدول بيانات مالي واحد ضمن التقرير (نمط التقرير المرجعي: عشرات الجداول
// المحاسبية المُخصَّصة). قد يتبع مهمة محددة (placement TASK) أو يتبع
// التقرير مباشرة (SCOPE لجدول الحصص ضمن نطاق الفحص، SETTLEMENT لجدول
// التصفية) — لهذا الحقل courtReportTaskId اختياري بدل اشتراط مهمة وهمية.
model CourtReportTable {
  id                String            @id @default(cuid())
  courtReportId     String
  courtReport       CourtReport       @relation(fields: [courtReportId], references: [id], onDelete: Cascade)
  courtReportTaskId String?
  courtReportTask   CourtReportTask?  @relation(fields: [courtReportTaskId], references: [id], onDelete: Cascade)

  placement String @default("TASK") // SCOPE | TASK | SETTLEMENT
  order     Int    @default(0)

  title    String // "(1) الإيرادات والمبيعات السنوية الفعلية:"
  subtitle String?

  columnsJson String // JSON: [{ key, label, align? }]
  rowsJson    String // JSON: [{ cells: string[], isTotal?: boolean }]
  basisNote   String? // سند الأرقام / أساس الاحتساب

  // مصدر الأرقام: DETERMINISTIC (حساب حتمي من مستند مُحلَّل فعلياً) |
  // AI_PROPOSED (اقتراح الذكاء الاصطناعي من نص المستند) | MANUAL (أدخلها
  // الخبير يدوياً). لا علاقة له بـ provenance أدناه — هذا مصدر الأرقام،
  // وذاك حالة مراجعة الخبير لها (كلا الأمرين مطلوب قبل التصدير).
  computation       String  @default("AI_PROPOSED")
  sourceDocumentIds String? // JSON string[] — Document.id
  computationJson   String? // لقطة مدخلات التجميع الحتمي، للتدقيق لاحقاً
  provenance        String  @default("AI_DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtReportId])
  @@index([courtReportTaskId])
}

// اعتراض طرف على التقرير المبدئي ورد الخبرة عليه (سابعاً: عرض التقرير
// المبدئي على الأطراف). نص الاعتراض منقول حرفياً من مذكرة التعقيب
// (EXTRACT)؛ رد الخبرة يُكتب يدوياً بالخبير دوماً في هذه النسخة (لا
// اقتراح ذكاء اصطناعي جماعي لردود على اعتراضات خصومية).
model ReportObjection {
  id            String      @id @default(cuid())
  courtReportId String
  courtReport   CourtReport @relation(fields: [courtReportId], references: [id], onDelete: Cascade)

  partyRole                String // CLAIMANT | RESPONDENT
  submittedOnBehalfOfLabel String // "وكيل المدعيين"
  objectionMemoDate        DateTime?
  order                    Int       @default(0)

  objectionText       String
  objectionProvenance String  @default("EXTRACT")
  responseText        String?
  responseProvenance  String  @default("AI_DRAFT")
  linkedTaskIndex     Int? // ربط اختياري بالمهمة محل الاعتراض

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtReportId])
}

// بيانات الخبير الحسابي الثابتة (اسم، صفة، رقم قيد، وسائل تواصل) — سجل
// واحد فقط، لأن هذا التطبيق بلا مستخدمين/مصادقة متعددة. تُستخدم في غلاف
// تقرير الخبرة وتوقيعه، وفي نموذج الإخطار (بدل إعادة كتابتها في كل مرة).
model ExpertProfile {
  id                 String   @id // ثابت: "default"
  expertName         String   @default("")
  expertTitle        String   @default("الخبير الحسابي")
  registrationNumber String   @default("") // رقم القيد وزارة العدل
  phone              String?
  fax                String?
  mobile             String?
  email              String?
  updatedAt          DateTime @updatedAt
}
