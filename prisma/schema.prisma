// Prisma schema for the case-file audit application.
// SQLite by default (zero-config, file-based); swap the datasource
// provider/url to postgresql for a multi-user production deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// A legal case / accounting-expert file being audited. Opened through the
// 4-phase judicial-expertise intake wizard (see intakeStatus).
// ---------------------------------------------------------------------------
model Case {
  id               String  @id @default(cuid())
  // --- المرحلة 1: بيانات القضية الأساسية ---
  caseNumber       String // رقم الدعوى
  title            String // عنوان/موضوع الدعوى (عنوان مختصر للقضية)
  court            String? // المحكمة / الجهة القضائية
  circuit          String? // الدائرة
  litigationDegree String? // FIRST_INSTANCE | APPEAL | EXECUTION | OTHER
  caseCategory     String? // نوع الدعوى: COMMERCIAL | CIVIL | REAL_ESTATE | LABOR | OTHER
  caseType         String  @default("ACCOUNTING_EXPERT") // LITIGATION | ACCOUNTING_EXPERT — selects which lib/presets.ts group applies
  notes            String? // ملاحظات أولية

  // --- المرحلة 2: بيانات مأمورية الخبرة ---
  mandateDecisionDate DateTime? // تاريخ قرار / حكم ندب الخبرة
  mandateReceivedDate DateTime? // تاريخ استلام المأمورية
  mandateAcceptedDate DateTime? // تاريخ قبول المأمورية
  nextHearingDate     DateTime? // تاريخ الجلسة القادمة
  reportDeadlineDate  DateTime? // آخر موعد لإيداع تقرير الخبرة
  appointmentCapacity String? // SOLE_EXPERT | COMMITTEE_CHAIR | COMMITTEE_MEMBER
  committeeMembers    String? // JSON: [{ name, specialization }] — إن كانت لجنة خبراء
  mandateNature       String? // JSON string[] من طبيعة المأمورية الحسابية (فحص وتدقيق الحسابات...)
  mandateNotes        String? // ملاحظات على المأمورية

  // تتبّع تقدّم المعالج (wizard) حتى يمكن استئناف ملف لم يُستكمل فتحه
  intakeStatus String @default("DRAFT_PHASE_1") // DRAFT_PHASE_1..4 | ACTIVE

  // مراسلة المتعامل (خطاب "استكمال المستندات" — منفصل عن وكلاء الأطراف في الإخطار)
  clientName  String? // اسم المتعامل (من نتلقى منه المستندات)
  clientEmail String? // البريد الإلكتروني للمتعامل

  status    String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties      CaseParty[]
  requirements Requirement[]
  documents    Document[]
  emailDrafts  EmailDraft[]
  notices      Notice[]
  analyses     CaseAnalysis[]
}

// ---------------------------------------------------------------------------
// A claimant/respondent party on a case (المدعي / المستأنف .. المدعى عليه /
// المستأنف ضده) — a case can have more than one of each.
// ---------------------------------------------------------------------------
model CaseParty {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role   String // CLAIMANT | RESPONDENT
  name   String
  order  Int    @default(0)

  submittedDocuments Document[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// A single required document/item in the case checklist (متطلبات الملف).
// ---------------------------------------------------------------------------
model Requirement {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  presetKey   String? // key referencing lib/presets.ts, null for fully custom items
  labelAr     String // اسم المتطلب بالعربية
  labelEn     String? // English label (optional, for reference)
  category    String? // تصنيف (مالي / قانوني / شركات ...)
  description String? // تفاصيل إضافية (مثال: الفترة الزمنية المطلوبة)
  periodStart DateTime? // بداية الفترة المطلوبة إن وجدت
  periodEnd   DateTime? // نهاية الفترة المطلوبة إن وجدت
  isRequired  Boolean   @default(true)
  order       Int       @default(0)

  status         String  @default("NOT_ANALYZED") // PROVIDED | PARTIALLY_PROVIDED | MISSING | NOT_ANALYZED
  aiNotes        String? // شرح/تعليل الذكاء الاصطناعي
  aiConfidence   Float?
  manualOverride Boolean @default(false) // true إذا عدّل المستخدم الحالة يدوياً
  overrideNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches RequirementMatch[]

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// An uploaded file belonging to a case.
// ---------------------------------------------------------------------------
model Document {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName       String
  storedPath     String // relative path under the uploads directory
  mimeType       String
  fileSize       Int
  fileKind       String // pdf | docx | xlsx | csv | image
  parseStatus    String   @default("PENDING") // PENDING | PARSED | FAILED | UNSUPPORTED
  parseError     String?
  extractedText  String? // plain-text extract used for AI matching
  detectedTitle  String? // عنوان المستند إن أمكن استنتاجه
  detectedDates  String? // JSON-encoded array of ISO dates found in the document
  detectedPeriod String? // نطاق الفترة الزمنية المستنتج (نص وصفي)
  pageCount      Int?
  uploadedAt     DateTime @default(now())

  // مُعبّأة من التحليل الأولي بالذكاء الاصطناعي (المرحلة 4) — تصنيف المستند
  // وتحديد الطرف الذي قدّمه، دون الحاجة لتصنيف يدوي عند الرفع.
  docCategory        String? // PRELIMINARY_RULING | STATEMENT_OF_CLAIM | PARTY_MEMO | PARTY_ATTACHMENT | OTHER_JUDICIAL | UNSPECIFIED
  submittedByPartyId String?
  submittedByParty   CaseParty? @relation(fields: [submittedByPartyId], references: [id], onDelete: SetNull)

  matches RequirementMatch[]

  @@index([caseId])
  @@index([submittedByPartyId])
}

// ---------------------------------------------------------------------------
// Join between a Requirement and a Document, produced by the AI matcher
// (a requirement can be satisfied by multiple documents and vice versa).
// ---------------------------------------------------------------------------
model RequirementMatch {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  confidence    Float       @default(0)
  reasoning     String? // تعليل المطابقة
  pageRefs      String? // مراجع الصفحات ذات الصلة، مثال: "2-4, 7"

  createdAt DateTime @default(now())

  @@unique([requirementId, documentId])
}

// ---------------------------------------------------------------------------
// A generated Arabic email/letter draft requesting missing documents.
// ---------------------------------------------------------------------------
model EmailDraft {
  id        String    @id @default(cuid())
  caseId    String
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subject   String
  bodyAr    String
  deadline  DateTime?
  createdAt DateTime  @default(now())

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// A formal notice (إخطار) — e.g. "اخطار اجتماع الخبرة الأول" — notifying the
// opposing parties' legal representatives of an expert meeting and
// requesting documents ahead of it. Content is deterministic (no AI): it
// follows a fixed legal letter format, rendered both as a printable
// letterhead document and as an email.
// ---------------------------------------------------------------------------
model Notice {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  noticeType  String @default("EXPERT_MEETING") // reserved for future notice types
  noticeLabel String // مثال: "الأول" / "الثاني"
  subjectLine String // موضوع الإخطار

  referenceLetterNumber String? // رقم كتاب التكليف
  referenceLetterDate   DateTime? // تاريخ كتاب التكليف

  meetingDate      DateTime
  meetingTimeLabel String // نص حر، مثال: "12:30 ظهراً"
  meetingMethod    String   @default("تقنية الاتصال المرئي بواسطة تطبيق تقنية ZOOM MEETING")
  meetingLink      String?
  meetingId        String?
  meetingPasscode  String?

  documentsDeadlineDays Int    @default(2)
  requestedFromLabel    String // من المطلوب منه تزويد المستندات، مثال: "وكيل المدعيان"

  addressees     String // JSON: [{ lawFirmName, roleLabel, representedNames: string[] }]
  requestedItems String // JSON: string[] — البنود المرقّمة

  expertTitle              String @default("الخبير الحسابي")
  expertName               String
  expertRegistrationNumber String // رقم القيد وزارة العدل

  createdAt DateTime @default(now())

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// المرحلة 4 — التحليل الأولي لملف الدعوى: تقرير مبدئي يقرأه الخبير ويعتمده،
// يُنتج بالذكاء الاصطناعي (أو بمحرك احتياطي محدود بدون مفتاح API) من كامل
// المستندات المرفوعة في المرحلة 3. عند الاعتماد تتحوّل missingDocuments إلى
// صفوف Requirement فعلية، فتستمر شاشة المتطلبات ونموذج الإخطار بالعمل دون
// أي تعديل.
// ---------------------------------------------------------------------------
model CaseAnalysis {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status String @default("DRAFT") // DRAFT | APPROVED
  mode   String // AI | OFFLINE

  caseSummary  String // ملخص الدعوى
  mandateText  String // نص مأمورية الخبرة كما ورد في الحكم
  mandateTasks String // JSON string[] — تقسيم المأمورية إلى مهام

  receivedDocumentsSummary String // JSON: [{ documentId, submittedByPartyId, periodLabel, status }]
  missingDocuments         String // JSON: [{ item, requestedFromPartyId, reason, relatedTask }]
  unclearPoints            String // JSON string[]
  claimantQuestions        String // JSON string[]
  respondentQuestions      String // JSON string[]
  expertNotes              String // ملاحظات أولية للخبير

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@index([caseId])
}
